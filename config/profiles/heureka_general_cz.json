{
  "extends": null,
  "output_filename": "heureka_general_cz.xml",
  "language": "cz",
  "currency": "CZK",
  "vat_default": 21,
  "root_element": "SHOP",
  "item_element": "SHOPITEM",
  "filter": {
    "pridat_do_feedu": "Ano",
    "feed_profil_match": true,
    "require_fields": [
      "Kód Lakma",
      "Web název CZ",
      "URL produktu CZ",
      "Cena CZK doporučená",
      "Heureka kategorie CZ"
    ],
    "ean_must_be_valid": true
  },
  "tags": [
    { "tag": "ITEM_ID",       "source": "Kód Lakma",                "required": true },
    { "tag": "PRODUCTNAME",   "source": "Web název CZ",             "required": true },
    { "tag": "URL",           "source": "URL produktu CZ",          "required": true },
    { "tag": "PRICE_VAT",     "source": "Cena CZK doporučená",      "format": "decimal", "required": true },
    { "tag": "VAT",           "constant": "21%" },
    { "tag": "CATEGORYTEXT",  "source": "Heureka kategorie CZ" },
    { "tag": "DESCRIPTION",   "source": "Web popis CZ",             "transform": "html_to_plain", "wrap_cdata": true },
    { "tag": "EAN",           "source": "EAN KS",                   "skip_if": "NA" },
    { "tag": "MANUFACTURER",  "constant": "Lakma" },
    { "tag": "ITEMGROUP_ID",  "source": "Itemgroup ID" },
    { "tag": "DELIVERY_DATE", "constant": "0" },
    { "tag": "IMGURL",        "source": "Foto 800×800",             "transform": "first_attachment_url" },
    { "tag": "IMGURL_ALTERNATIVE", "source": "Galerie produktu",    "transform": "all_attachment_urls", "repeat": true }
  ],
  "params": [
    { "name": "Vůně",               "source": "Vůně" },
    { "name": "Objem",              "source": "Objem" },
    { "name": "Vhodné povrchy",     "source": "Vhodné povrchy" },
    { "name": "Hlavní technologie", "source": "Hlavní technologie" }
  ],
  "delivery": [],
  "extras": []
}
